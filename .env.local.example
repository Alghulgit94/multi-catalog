# Supabase (proyecto nuevo, usado solo como base de datos Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SOLO servidor. Nunca con prefijo NEXT_PUBLIC_
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres   # Better Auth

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Login con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (carpetas por tienda: stores/{storeId}/...)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret            # NEVER prefix with NEXT_PUBLIC_

# Emails (Resend). Sin API key los emails se imprimen en consola
RESEND_API_KEY=
EMAIL_FROM=Plataforma <no-reply@tu-dominio.com>

# Plataforma
NEXT_PUBLIC_PLATFORM_NAME=Multi Store Catalog
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # Origen publico para links absolutos (WhatsApp + Open Graph). Vacio = se deriva del request

# Cron diario (Vercel lo envia como Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-random-string
