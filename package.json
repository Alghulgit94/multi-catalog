  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "cf workers types && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
